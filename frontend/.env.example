# Local kiosk frontend. No Strapi service is used by this repository.
NEXT_PUBLIC_BACKEND_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEBUG=false
# Development-only key, matching backend ADMIN_ACCESS_KEY; browser-visible.
NEXT_PUBLIC_ADMIN_KEY=local-kiosk-admin-only
# Optional server-side frontend AI path; never prefix this key with NEXT_PUBLIC.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
