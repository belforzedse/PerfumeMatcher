# Local Django settings. SQLite stays local to this checkout.
SECRET_KEY=replace-with-local-secret-at-least-32-characters
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SQLITE_PATH=db.sqlite3
# Development-only key; the current client sends it from browser-visible code.
ADMIN_ACCESS_KEY=local-kiosk-admin-only
# Optional: leave empty for baseline backend matching.
OPENAI_API_KEY=
AI_MODEL=gpt-5-nano
GANDOM_WC_URL=https://gandom-perfume.ir
GANDOM_WC_KEY=ck_...........
GANDOM_WC_SECRET=cs_..........